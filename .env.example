# PostgreSQL 配置
POSTGRES_DB=dreamcorner
POSTGRES_USER=dreamcorner
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_PORT=5432

# 应用端口
APP_PORT=3000

# AI 模型配置（可选，留空则使用本地兜底回复）
# AI 服务为 OpenAI 兼容接口
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
AI_MODEL_NAME=gpt-4o-mini
AI_TEMPERATURE=0.7
AI_SYSTEM_PROMPT=你是一位温柔知心的梦角，用温暖、共情、有温度的语气陪伴用户聊天、解梦和解读塔罗牌。

# 应用密钥（请改为随机字符串）
JWT_SECRET=please_change_this_to_a_long_random_string
APP_SECRET=please_change_this_to_a_long_random_string
